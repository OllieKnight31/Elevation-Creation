# Easiest: run `npm run setup` and answer the questions. It writes .env.local for you.
# Every value below can also be entered in the app under Settings, Database and setup.

# Claude (replies, tagging, summaries, inbox analysis). Without it the app runs a clearly labelled demo engine.
ANTHROPIC_API_KEY=

# Supabase (optional). Without these, data is kept in one file beside the app.
# Use the service role (secret) key. Create the tables with supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Meta app (developers.facebook.com). Needed for the Instagram login screen and live webhooks.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=choose-any-string
META_GRAPH_VERSION=v25.0
# Public https URL of this app. Used for the OAuth redirect, webhooks and links back from the CRM.
APP_BASE_URL=

# Port for `npm run serve`.
PORT=3000
